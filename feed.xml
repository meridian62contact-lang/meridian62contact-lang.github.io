---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
<channel>
  <title>{{ site.title | xml_escape }}</title>
  <description>{{ site.description | xml_escape }}</description>
  <link>{{ site.url }}{{ site.baseurl }}/</link>
  <atom:link href="{{ site.url }}{{ site.baseurl }}/feed.xml" rel="self" type="application/rss+xml"/>
  <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
  <pubDate>{{ site.time | date_to_rfc822 }}</pubDate>
  <ttl>60</ttl>
  {%- assign all_notes = site.notes | where_exp: "n", "n.published != false" | sort: "week" | reverse -%}
  {%- for n in all_notes limit:20 -%}
  {%- assign s = site.sectors | where: "slug", n.sector | first -%}
  {%- assign w = n.week | date: "%Y-%m-%d" -%}
  <item>
    <title>{{ n.headline | xml_escape }}</title>
    <description>{{ n.content | markdownify | strip_html | truncatewords: 60 | xml_escape }}</description>
    <link>{{ site.url }}{{ site.baseurl }}{{ s.url }}#{{ w }}</link>
    <guid isPermaLink="true">{{ site.url }}{{ site.baseurl }}{{ s.url }}#{{ w }}</guid>
    <pubDate>{{ n.week | date_to_rfc822 }}</pubDate>
  </item>
  {%- endfor -%}
</channel>
</rss>
